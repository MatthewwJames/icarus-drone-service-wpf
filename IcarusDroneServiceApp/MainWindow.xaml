<Window x:Class="IcarusDroneServiceApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:IcarusDroneServiceWPF"
        mc:Ignorable="d"
        Title="Icarus Drone Service App"
        Height="720"
        Width="1150"
        WindowStartupLocation="CenterScreen">

    <DockPanel Margin="12">

        <StatusBar DockPanel.Dock="Bottom" Height="28">
            <StatusBarItem>
                <TextBlock x:Name="txtStatus" Text="Ready." />
            </StatusBarItem>
        </StatusBar>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="220" />
            </Grid.RowDefinitions>

            <GroupBox Header="New Service Item" Grid.Row="0" Padding="12" Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Text="Client Name" Grid.Row="0" Grid.Column="0" Margin="0,0,10,4" FontWeight="SemiBold" />
                    <TextBox x:Name="txtClientName" Grid.Row="1" Grid.Column="0" Margin="0,0,10,12" Height="28" />

                    <TextBlock Text="Drone Model" Grid.Row="0" Grid.Column="1" Margin="0,0,10,4" FontWeight="SemiBold" />
                    <TextBox x:Name="txtDroneModel" Grid.Row="1" Grid.Column="1" Margin="0,0,10,12" Height="28" />

                    <TextBlock Text="Service Problem" Grid.Row="0" Grid.Column="2" Margin="0,0,10,4" FontWeight="SemiBold" />
                    <TextBox x:Name="txtServiceProblem"
                             Grid.Row="1"
                             Grid.RowSpan="3"
                             Grid.Column="2"
                             Margin="0,0,10,12"
                             Height="80"
                             TextWrapping="Wrap"
                             AcceptsReturn="True"
                             VerticalScrollBarVisibility="Auto" />

                    <TextBlock Text="Service Cost ($)" Grid.Row="0" Grid.Column="3" Margin="0,0,0,4" FontWeight="SemiBold" />
                    <TextBox x:Name="txtServiceCost"
                                Grid.Row="1"
                                Grid.Column="3"
                                Margin="0,0,0,12"
                                Height="28"
                                TextAlignment="Right"
                                PreviewTextInput="ServiceCost_PreviewTextInput"
                                LostFocus="ServiceCost_LostFocus" />

                    <TextBlock Text="Service Tag" Grid.Row="2" Grid.Column="0" Margin="0,0,10,4" FontWeight="SemiBold" />
                    <TextBox x:Name="txtServiceTag"
                             Grid.Row="3"
                             Grid.Column="0"
                             Margin="0,0,10,0"
                             Height="28"
                             Text="100"
                             IsReadOnly="True" />

                    <TextBlock Text="Priority" Grid.Row="2" Grid.Column="1" Margin="0,0,10,4" FontWeight="SemiBold" />
                    <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" Margin="0,0,10,0">
                        <RadioButton x:Name="radRegular"
                                     Content="Regular"
                                     GroupName="ServicePriority"
                                     IsChecked="True"
                                     Margin="0,0,20,0"
                                     VerticalAlignment="Center" />

                        <RadioButton x:Name="radExpress"
                                     Content="Express"
                                     GroupName="ServicePriority"
                                     VerticalAlignment="Center" />
                    </StackPanel>

                    <StackPanel Grid.Row="3" Grid.Column="3" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="btnAddNewItem"
                                Content="Add New Item"
                                Width="120"
                                Height="32"
                                Margin="0,0,10,0"
                                Click="AddNewItem" />

                        <Button x:Name="btnClearInputs"
                                Content="Clear Inputs"
                                Width="110"
                                Height="32"
                                Click="ClearInputs_Click" />
                    </StackPanel>
                </Grid>
            </GroupBox>

            <Grid Grid.Row="1" Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="20" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <GroupBox Header="Regular Queue" Grid.Column="0" Padding="8">
                    <ListView x:Name="lvRegularQueue" MouseLeftButtonUp="RegularQueue_Click">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="Tag" Width="45" DisplayMemberBinding="{Binding ServiceTag}" />
                                <GridViewColumn Header="Client" Width="105" DisplayMemberBinding="{Binding ClientName}" />
                                <GridViewColumn Header="Model" Width="115" DisplayMemberBinding="{Binding DroneModel}" />
                                <GridViewColumn Header="Problem" Width="175" DisplayMemberBinding="{Binding ServiceProblem}" />
                                <GridViewColumn Header="Cost" Width="80" DisplayMemberBinding="{Binding ServiceCostDisplay}" />
                            </GridView>
                        </ListView.View>
                    </ListView>
                </GroupBox>

                <GroupBox Header="Express Queue" Grid.Column="2" Padding="8">
                    <ListView x:Name="lvExpressQueue" MouseLeftButtonUp="ExpressQueue_Click">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="Tag" Width="45" DisplayMemberBinding="{Binding ServiceTag}" />
                                <GridViewColumn Header="Client" Width="105" DisplayMemberBinding="{Binding ClientName}" />
                                <GridViewColumn Header="Model" Width="115" DisplayMemberBinding="{Binding DroneModel}" />
                                <GridViewColumn Header="Problem" Width="160" DisplayMemberBinding="{Binding ServiceProblem}" />
                                <GridViewColumn Header="Cost" Width="80" DisplayMemberBinding="{Binding ServiceCostDisplay}" />
                            </GridView>
                        </ListView.View>
                    </ListView>
                </GroupBox>
            </Grid>

            <GroupBox Header="Finished Items" Grid.Row="2" Padding="8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="220" />
                    </Grid.ColumnDefinitions>

                    <ListBox x:Name="lstFinishedItems"
                             Grid.Column="0"
                             MouseDoubleClick="FinishedItems_DoubleClick" />

                    <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Top">
                        <Button x:Name="btnCompleteRegular"
                                Content="Complete Regular"
                                Height="34"
                                Margin="0,0,0,10"
                                Click="CompleteRegular_Click" />

                        <Button x:Name="btnCompleteExpress"
                                Content="Complete Express"
                                Height="34"
                                Click="CompleteExpress_Click" />
                    </StackPanel>
                </Grid>
            </GroupBox>
        </Grid>
    </DockPanel>
</Window>